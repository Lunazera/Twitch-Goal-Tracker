{
	"main-settings": {
		"label": "Twitch Goal Tracker",
		"settings": {
			"widget-desc": {
				"type": "text-display",
				"label": "This is a goal tracker progress bar for Twitch, set up to work with the Twitch Dono Clock (https://github.com/Latent-Logic/twitch-dono-clock)\n\nYou can either have this track a single goal, or track through a list of milestones."
			},
			"websocket-settings": {
				"type": "section",
				"label": "Websocket",
				"settings": {
					"wss-url": {
						"type": "text-input",
						"label": "Websocket URL",
						"condition": {},
						"placeholder": "wss://",
						"description": "Target address for the websocket listener. This will establish a websocket connection that'll update whenever a donation event is received from the bot server."
					},
					"server-connect": {
						"type": "toggle-input",
						"label": "Connect to server",
						"halfSpan": true,
						"defaultValue": false,
						"description": "Toggles whether to try to connect to the websocket. If false, you'll be able to set an placeholder amount for testing."
					},
					"test-amount-val": {
						"type": "number-input",
						"label": "Placeholder amount",
						"condition": {},
						"halfSpan": true,
						"defaultValue": 500,
						"min": 0,
						"placeholder": "$ amount",
						"description": "Uses this as the current amount raised when the server is not connected"
					},
					"ws-reconnect": {
						"type": "button",
						"label": "Reconnect"
					},
					"server-info": {
						"type": "text-display",
						"label": "This will try to establish a websocket connection when the page first loads, but shouldn't keep trying whenever you change you change values. If you aren't seeing the amount value update, Inspect page in your browser to see if there are connection issues"
					}
				}
			}
		}
	},
	"progress-bar-settings": {
		"label": "Progress Bar",
		"settings": {
			"bar-settings": {
				"type": "section",
				"label": "Bar Settings",
				"settings": {
					"bar-type": {
						"type": "dropdown-input",
						"label": "Progress Bar Type",
						"defaultValue": "bar-goal",
						"description": "Change the type of progress bar. Either setting will reveal it's own sub-settings",
						"options": [
							{
								"label": "Donation Goal",
								"value": "bar-goal"
							},
							{
								"label": "Milestone Goals",
								"value": "bar-milestone"
							}
						]
					},
					"rescale-bar-toggle": {
						"type": "toggle-input",
						"label": "Rescale Bar?",
						"halfSpan": true,
						"defaultValue": true,
						"description": "Whether to rescale the bar with an offset. In Goal bar mode, you can set this offset directly. In Milestone mode, this offset is based on the previous hit milestone."
					},
					"goal-heading": {
						"type": "heading",
						"label": "Goal Bar Settings",
						"condition": {
							"bar-type": [
								"bar-goal"
							]
						}
					},
					"goal": {
						"type": "number-input",
						"label": "Goal",
						"condition": {
							"bar-type": [
								"bar-goal"
							]
						},
						"halfSpan": true,
						"defaultValue": 1000,
						"min": 0,
						"placeholder": "Goal $ amount",
						"description": "Goal of donation bar"
					},
					"offset-amount": {
						"type": "number-input",
						"label": "Offset",
						"condition": {
							"bar-type": [
								"bar-goal"
							]
						},
						"halfSpan": true,
						"defaultValue": 100,
						"min": 0,
						"placeholder": "$ amount",
						"description": "Value for rescaling offset"
					},
					"milestone-heading": {
						"type": "heading",
						"label": "Milestone Bar Settings",
						"condition": {
							"bar-type": [
								"bar-milestone"
							]
						}
					},
					"milestone-list": {
						"type": "text-area-input",
						"label": "Milestone List",
						"condition": {
							"bar-type": [
								"bar-milestone"
							]
						},
						"defaultValue": "500, milestone",
						"placeholder": "number, text",
						"description": "List of milestones, formatted as [number, text].\nexample: 500, eat a pickle"
					}
				}
			},
			"bar-style": {
				"type": "section",
				"label": "Bar Appearance",
				"settings": {
					"bar-height": {
						"type": "slider-input",
						"label": "Bar Height",
						"defaultValue": 25,
						"min": 0,
						"max": 1000,
						"step": 0.5
					},
					"bar-width": {
						"type": "slider-input",
						"label": "Bar Width",
						"defaultValue": 500,
						"min": 0,
						"max": 2000,
						"step": 0.5
					},
					"bar-fill-color": {
						"type": "color-input",
						"label": "Bar Progress Colour",
						"halfSpan": true,
						"defaultValue": "#de4646"
					},
					"bar-color": {
						"type": "color-input",
						"label": "Bar Background Color",
						"halfSpan": true,
						"defaultValue": "#6262628a"
					},
					"border-radius": {
						"type": "slider-input",
						"label": "Bar Corner Radius",
						"defaultValue": 0,
						"min": 0,
						"max": 50,
						"step": 1
					},
					"bar-border-color": {
						"type": "color-input",
						"label": "Bar Border Color",
						"halfSpan": true,
						"defaultValue": "#fff"
					},
					"bar-border-size": {
						"type": "slider-input",
						"label": "Bar Border Thickness",
						"halfSpan": true,
						"defaultValue": 0,
						"min": 0,
						"max": 15,
						"step": 1
					},
					"top-margin": {
						"type": "slider-input",
						"label": "Top Margin",
						"halfSpan": true,
						"defaultValue": 0,
						"min": 0,
						"max": 100,
						"step": 1
					},
					"left-margin": {
						"type": "slider-input",
						"label": "Left Margin",
						"halfSpan": true,
						"defaultValue": 0,
						"min": 0,
						"max": 100,
						"step": 1
					}
				}
			}
		}
	},
